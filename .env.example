# Copie este arquivo para .env e preencha os valores.
# Na Vercel, cadastre as mesmas variáveis em Settings > Environment Variables
# e faça Redeploy depois de mudar alguma (o Vite grava os valores no build).

# URL base da API (sem barra no final)
# Produção: https://grupo13-backend-megw.onrender.com
# Local: http://127.0.0.1:8000
VITE_API_URL=

# URL do projeto Supabase (Project Settings > API > Project URL)
# Formato: https://<project-ref>.supabase.co (sem barra no final)
VITE_SUPABASE_URL=

# Chave pública do Supabase (Project Settings > API Keys > publishable/anon key)
# Nunca use a service_role aqui: tudo que começa com VITE_ fica visível no navegador.
VITE_SUPABASE_PUBLISHABLE_KEY=
